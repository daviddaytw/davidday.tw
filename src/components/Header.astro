---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.jpg';
import ycombinator from '../assets/Y_Combinator.jpg';
import foundersinc from '../assets/Founders,inc.jpg';
---

<div class="landing-container">
	<div class="name-section">
		<div class="name-content">
			<h1 class="name">David Day</h1>
			<h2 class="chinese-name">戴惟</h2>
			<p class="tagline">從台灣學生到矽谷創業者 | 23 歲</p>
			<div class="badges">
				<Image src={ycombinator} alt="Y Combinator" class="badge" loading="eager" />
				<Image src={foundersinc} alt="Founders Inc" class="badge" loading="eager" />
			</div>
			<div class="nav-links">
				<a href="#portfolios" class="nav-link">Portfolios →</a>
				<a href="/formosa" class="nav-link">Formosa →</a>
			</div>
		</div>
	</div>

	<div class="avatar-section">
		<Image src={avatar} alt="David Day" class="avatar-image" loading="eager" />
	</div>
</div>

<style>
	.landing-container {
		height: 100vh;
		width: 100vw;
		display: flex;
		margin: 0;
		padding: 0;
		overflow: hidden;
	}

	.name-section {
		flex: 1;
		background: #000;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 4rem;
		position: relative;
		height: 100%;
	}

	.name-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.name {
		font-size: clamp(3rem, 7vw, 5rem);
		font-weight: 300;
		letter-spacing: -0.02em;
		line-height: 1.1;
		margin: 0;
		color: #fff;
	}

	.chinese-name {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 200;
		margin-top: 1rem;
		color: #fff;
		opacity: 0.8;
	}

	.tagline {
		font-size: clamp(0.875rem, 1.5vw, 1.125rem);
		font-weight: 300;
		margin-top: 1.5rem;
		color: #fff;
		opacity: 0.6;
		letter-spacing: 0.02em;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		margin-top: 2.5rem;
		flex-wrap: wrap;
	}

	.nav-link {
		display: inline-block;
		font-size: clamp(0.875rem, 1.5vw, 1rem);
		font-weight: 500;
		color: #fff;
		text-decoration: none;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		border-bottom: 2px solid #fff;
		padding-bottom: 0.5rem;
		transition: all 0.3s ease;
		opacity: 0.8;
	}

	.nav-link:hover {
		opacity: 1;
		transform: translateX(4px);
		border-bottom-color: #fff;
	}

	.badges {
		display: flex;
		gap: 1.5rem;
		margin-top: 2rem;
		align-items: center;
	}

	.badge {
		height: 60px;
		width: auto;
		object-fit: contain;
		opacity: 0.9;
		background: #fff;
		padding: 0.25rem;
	}

	.avatar-section {
		flex: 1;
		background: #fff;
		display: flex;
		align-items: stretch;
		justify-content: stretch;
		overflow: hidden;
		height: 100%;
	}

	.avatar-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	@media (max-width: 768px) {
		.landing-container {
			flex-direction: column;
			height: 100vh;
		}

		.name-section {
			flex: 1;
		}

		.name-content {
			align-items: center;
			text-align: center;
		}

		.avatar-section {
			flex: 1;
		}

		.badges {
			justify-content: center;
		}

		.badge {
			height: 50px;
		}
	}

	@media (prefers-color-scheme: dark) {
		.avatar-section {
			background: #000;
		}
	}
</style>
