---
import { Image } from 'astro:assets';
import chatbottaLogo from '../assets/chatbotta.png';
import skiesoftLogo from '../assets/skiesoft.png';
import lunabillLogo from '../assets/lunabill.png';
import parseLogo from '../assets/parse.png';
import opalitehealthLogo from '../assets/opalitehealth.png';
---

<section id="portfolios" class="portfolios-section">
	<div class="section-container">
		<div class="section-header">
			<h2 class="section-title">Portfolios</h2>
			<p class="section-subtitle">我投資的未來科技</p>
		</div>

		<div class="portfolios-grid">
			<div class="portfolio-card">
				<div class="card-content">
					<div class="logo-wrapper">
						<Image src={skiesoftLogo} alt="Skiesoft Logo" class="company-logo" loading="lazy" />
					</div>
					<div class="company-header">
						<h3 class="company-name">軟雲股份有限公司</h3>
						<span class="co-founder-tag">CO-FOUNDER</span>
					</div>
					<a href="https://skiesoft.com/" target="_blank" class="company-link" data-simple-event="portfolio_skiesoft">查看官網 →</a>
				</div>
			</div>

			<div class="portfolio-card">
				<div class="card-content">
					<div class="logo-wrapper">
						<Image src={chatbottaLogo} alt="Chatbotta Logo" class="company-logo" loading="lazy" />
					</div>
					<div class="company-header">
						<h3 class="company-name">創易聊股份有限公司</h3>
						<span class="co-founder-tag">CO-FOUNDER</span>
					</div>
					<a href="https://chatbotta.com" target="_blank" class="company-link" data-simple-event="portfolio_chatbotta">查看官網 →</a>
				</div>
			</div>

			<div class="portfolio-card">
				<div class="card-content">
					<div class="logo-wrapper">
						<Image src={lunabillLogo} alt="LunaBill Logo" class="company-logo" loading="lazy" />
					</div>
					<div class="company-header">
						<h3 class="company-name">LunaBill</h3>
						<span class="co-founder-tag">CO-FOUNDER</span>
					</div>
					<a href="https://lunabill.com" target="_blank" class="company-link" data-simple-event="portfolio_lunabill">查看官網 →</a>
				</div>
			</div>

			<div class="portfolio-card">
				<div class="card-content">
					<div class="logo-wrapper">
						<Image src={parseLogo} alt="Parse Logo" class="company-logo" loading="lazy" />
					</div>
					<div class="company-header">
						<h3 class="company-name">Parse</h3>
						<span class="investor-tag">INVESTOR</span>
					</div>
					<a href="https://www.parse.bot/" target="_blank" class="company-link" data-simple-event="portfolio_parse">查看官網 →</a>
				</div>
			</div>

			<div class="portfolio-card">
				<div class="card-content">
					<div class="logo-wrapper">
						<Image src={opalitehealthLogo} alt="Opalite Health Logo" class="company-logo" loading="lazy" />
					</div>
					<div class="company-header">
						<h3 class="company-name">Opalite Health</h3>
						<span class="investor-tag">INVESTOR</span>
					</div>
					<a href="https://opalitehealth.com/" target="_blank" class="company-link" data-simple-event="portfolio_opalitehealth">查看官網 →</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.portfolios-section {
		min-height: 100vh;
		background: #000;
		color: #fff;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.section-container {
		max-width: 1400px;
		width: 100%;
		margin: 0 auto;
		padding: 6rem 4rem;
	}

	.section-header {
		margin-bottom: 4rem;
		border-bottom: 1px solid #fff;
		padding-bottom: 1.5rem;
	}

	.section-title {
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 300;
		letter-spacing: -0.02em;
		line-height: 1;
		margin: 0 0 0.5rem 0;
		color: #fff;
		text-transform: uppercase;
	}

	.section-subtitle {
		font-size: clamp(1rem, 2vw, 1.25rem);
		font-weight: 200;
		color: #fff;
		margin: 0;
		letter-spacing: 0.02em;
	}

	.portfolios-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	.portfolio-card {
		background: #000;
		border: 1px solid #fff;
		padding: 2.5rem;
		transition: background-color 0.3s ease, border-color 0.3s ease;
		position: relative;
	}

	.portfolio-card:hover {
		background: #fff;
		border-color: #000;
	}

	.portfolio-card:hover .card-content,
	.portfolio-card:hover .company-name,
	.portfolio-card:hover .company-link {
		color: #000;
	}

	.portfolio-card:hover .co-founder-tag,
	.portfolio-card:hover .investor-tag {
		background: #000;
		color: #fff;
		border-color: #000;
	}

	.portfolio-card:hover .logo-wrapper {
		border-color: #000;
	}

	.card-content {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		transition: color 0.3s ease;
	}

	.logo-wrapper {
		width: 80px;
		height: 80px;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 1px solid #fff;
		background: #fff;
		transition: border-color 0.3s ease;
	}

	.company-logo {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 0.5rem;
	}

	.company-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.company-name {
		font-size: clamp(1.25rem, 2vw, 1.5rem);
		font-weight: 500;
		margin: 0;
		color: #fff;
		letter-spacing: -0.01em;
		transition: color 0.3s ease;
	}

	.co-founder-tag,
	.investor-tag {
		display: inline-block;
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		padding: 0.25rem 0.5rem;
		background: #fff;
		color: #000;
		border: 1px solid #fff;
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.company-link {
		display: inline-block;
		color: #fff;
		text-decoration: none;
		font-weight: 400;
		font-size: 0.875rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		transition: opacity 0.3s ease, color 0.3s ease;
	}

	.company-link:hover {
		opacity: 1;
	}

	.portfolio-card:hover .company-link {
		color: #000;
	}

	@media (max-width: 1024px) {
		.section-container {
			padding: 5rem 3rem;
		}

		.portfolios-grid {
			gap: 1.5rem;
		}
	}

	@media (max-width: 768px) {
		.section-container {
			padding: 4rem 2rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}

		.portfolios-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.portfolio-card {
			padding: 2rem;
		}

		.logo-wrapper {
			width: 60px;
			height: 60px;
		}
	}
</style>
